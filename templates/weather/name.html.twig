{% extends 'base.html.twig' %}

{#@var place \App\Entity\Place#}
{#@var forecasts \App\Entity\Forecast[]#}

{% block title %}Weather in {{ place.name }}, {{ place.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ place.name }}, {{ place.country }}</h1>

        <ul>
            {% for forecast in forecasts %}
                <li>{{ forecast.date|date('d.m.Y') }}: {{ forecast.temperature }}&deg;C</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
